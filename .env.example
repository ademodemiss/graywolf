# GrayWolf Environment Template
# Copy to .env and fill values.

# =========================
# Common LLM Keys
# =========================
GOOGLE_API_KEY=
OPENAI_API_KEY=

# =========================
# Mail Provider Selection
# =========================
# MAIL_PROVIDER: smtp | graph
MAIL_PROVIDER=smtp

# =========================
# SMTP (Gmail - recommended quick setup)
# =========================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=your@gmail.com
# SMTP_AUTH_METHOD=basic

# =========================
# SMTP (Outlook basic - may be disabled by provider policy)
# =========================
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your@outlook.com
# SMTP_PASS=app_password_or_account_password
# SMTP_FROM=your@outlook.com
# SMTP_AUTH_METHOD=basic

# =========================
# SMTP OAuth2 (advanced Outlook path)
# =========================
# SMTP_AUTH_METHOD=oauth2
# SMTP_OAUTH2_TOKEN=
