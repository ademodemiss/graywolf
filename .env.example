# GrayWolf Environment Template
# =========================
# Copy this file to .env, fill the values, and keep the file out of version control.

# -------------------------
# Common LLM Keys
# -------------------------
GOOGLE_API_KEY=
OPENAI_API_KEY=

# -------------------------
# Provider Selection (Phase 6)
# -------------------------
# Supported values: gmail, outlook
SMTP_PROVIDER=gmail

# -------------------------
# Gmail (App Password) — recommended quick setup
# -------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_FROM=your@gmail.com
SMTP_AUTH_METHOD=basic
SMTP_PASS=your_16_char_app_password

# -------------------------
# Outlook Basic (policy may block this path)
# -------------------------
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=your@outlook.com
SMTP_FROM=your@outlook.com
SMTP_AUTH_METHOD=basic
SMTP_PASS=app_password_or_account_password

# -------------------------
# Outlook OAuth2 (if basic auth is blocked)
# -------------------------
# SMTP_AUTH_METHOD=oauth2
# SMTP_OAUTH2_TOKEN=ya29.a0AfH6SMD... (rotate tokens frequently)

# -------------------------
# Secret Storage Guidance
# -------------------------
# - Treat SMTP_PASS/SMTP_OAUTH2_TOKEN as secrets: do not commit them or drop them into chats.
# - Store secrets in secure vaults, OS keyrings, or injected environment variables.
# - Rotate credentials after exposure or every 90 days, and revoke old tokens.
# - Use `tools/provider_setup_wizard.py --provider <gmail|outlook>` to generate masked templates.
# - After filling .env run `python -m tools.mail_tool --action check-smtp --provider $SMTP_PROVIDER`,
#   then `--action test-smtp`, followed by `--action send --dry-run=false` when you're ready.
